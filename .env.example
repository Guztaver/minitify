# Environment Variables for Minitify Application

# MongoDB Configuration
MONGO_URI=mongodb://minitify:minitify@localhost:27017/minitify
MONGO_DATABASE=minitify

# JWT Configuration
JWT_SHARED_SECRET=my-secret-key-that-is-at-least-256-bits-long-for-hs256
JWT_ISSUER=minitify
JWT_EXPIRATION_MS=3600000

# Server Configuration
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Logging Configuration
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_DATA_MONGODB_CORE_MONGOTEMPLATE=DEBUG